// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// User
// =========================

model User {
  id        String   @id @default(uuid()) @map("user_id")
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  attempts  Attempt[]
  solutions Solution[]
  stats     UserStats?

  @@map("users")
}

// =========================
// Puzzle
// =========================

model Puzzle {
  id                   String    @id @default(uuid()) @map("puzzle_id")
  date                 DateTime  @unique @db.Date
  seed                 String
  configuration        Json
  difficulty           Int
  authorSolution       Json?     @map("author_solution")
  createdAt            DateTime  @default(now()) @map("created_at")
  title                String    @default("")
  rules                Json?
  availabilityRevision BigInt    @default(0) @map("availability_revision")
  boardRevision        BigInt    @default(0) @map("board_revision")
  canceledAt           DateTime? @map("canceled_at")
  cancellationMessage  String?   @map("cancellation_message")

  attempts      Attempt[]
  solutions     Solution[]
  runs          CompetitiveRun[]
  guestProgress GuestProgress[]

  @@map("puzzles")
}

model Guest {
  id                String           @id @default(uuid())
  sessionHash       String           @unique @map("session_hash")
  nickname          String
  createdAt         DateTime         @default(now()) @map("created_at")
  expiresAt         DateTime         @map("expires_at")
  nicknameUpdatedAt DateTime?        @map("nickname_updated_at")
  runs              CompetitiveRun[]
  progress          GuestProgress[]

  @@map("guests")
}

model ApiRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt], map: "api_rate_limits_expiry_idx")
  @@map("api_rate_limits")
}

model ServiceSetting {
  name  String @id
  value String

  @@map("service_settings")
}

model GuestProgress {
  guestId            String @map("guest_id")
  puzzleId           String @map("puzzle_id")
  revision           BigInt @default(0)
  attemptsStarted    Int    @default(0) @map("attempts_started")
  firstSolveAttempts Int?   @map("first_solve_attempts")
  bestDaily          Json?  @map("best_daily")
  bestArchive        Json?  @map("best_archive")
  guest              Guest  @relation(fields: [guestId], references: [id])
  puzzle             Puzzle @relation(fields: [puzzleId], references: [id])

  @@id([guestId, puzzleId])
  @@index([puzzleId], map: "guest_progress_puzzle_idx")
  @@map("guest_progress")
}

model CompetitiveRun {
  id                   String    @id @default(uuid())
  requestId            String    @unique @map("request_id")
  guestId              String    @map("guest_id")
  puzzleId             String    @map("puzzle_id")
  startHash            String    @map("start_hash")
  placement            Json
  attemptOrdinal       Int       @map("attempt_ordinal")
  startedAt            DateTime  @default(now()) @map("started_at")
  revision             BigInt    @default(1)
  state                String    @default("accepted")
  completion           Json?
  result               Json?
  rejection            Json?
  dailyEligible        Boolean   @default(false) @map("daily_eligible")
  leaseToken           String?   @map("lease_token")
  leaseUntil           DateTime? @map("lease_until")
  verificationFailures Int       @default(0) @map("verification_failures")
  guest                Guest     @relation(fields: [guestId], references: [id])
  puzzle               Puzzle    @relation(fields: [puzzleId], references: [id])

  @@index([guestId, startedAt], map: "competitive_runs_guest_started_idx")
  @@index([puzzleId, state, dailyEligible], map: "competitive_runs_puzzle_state_idx")
  @@map("competitive_runs")
}

// =========================
// Attempt
// =========================

model Attempt {
  id             String   @id @default(uuid()) @map("attempt_id")
  userId         String?  @map("user_id")
  puzzleId       String   @map("puzzle_id")
  submittedAt    DateTime @default(now()) @map("submitted_at")
  success        Boolean  @default(false)
  simulationTime Float?   @map("simulation_time")
  forceCost      Int?     @map("force_cost")
  tileCount      Int?     @map("tile_count")
  pathLength     Float?   @map("path_length")

  user     User?     @relation(fields: [userId], references: [id])
  puzzle   Puzzle    @relation(fields: [puzzleId], references: [id])
  solution Solution?

  @@index([userId])
  @@index([puzzleId])
  @@map("attempts")
}

// =========================
// Solution
// =========================

model Solution {
  id              String   @id @default(uuid()) @map("solution_id")
  userId          String?  @map("user_id")
  puzzleId        String   @map("puzzle_id")
  attemptId       String   @unique @map("attempt_id")
  placementData   Json     @map("placement_data")
  dailyRank       Int?     @map("daily_rank")
  dailyPercentile Float?   @map("daily_percentile")
  createdAt       DateTime @default(now()) @map("created_at")

  user    User?   @relation(fields: [userId], references: [id])
  puzzle  Puzzle  @relation(fields: [puzzleId], references: [id])
  attempt Attempt @relation(fields: [attemptId], references: [id])

  @@index([userId])
  @@index([puzzleId])
  @@map("solutions")
}

// =========================
// User Stats
// =========================

model UserStats {
  userId            String @id @map("user_id")
  gamesPlayed       Int    @default(0) @map("games_played")
  gamesSolved       Int    @default(0) @map("games_solved")
  currentStreak     Int    @default(0) @map("current_streak")
  bestStreak        Int    @default(0) @map("best_streak")
  averagePercentile Float  @default(0) @map("average_percentile")

  user User @relation(fields: [userId], references: [id])

  @@map("user_stats")
}
