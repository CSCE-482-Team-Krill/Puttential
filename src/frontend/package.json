{
  "name": "puttential-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../../scripts/prisma-generate.mjs",
    "dev": "next dev",
    "prebuild": "node ../../scripts/prisma-generate.mjs",
    "build": "next build",
    "start": "next start",
    "preview": "PRISMA_RUNTIME=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "PRISMA_RUNTIME=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "PRISMA_RUNTIME=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "wrangler": "^4.152.0"
  }
}
